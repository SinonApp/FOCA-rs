{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FOCA-rs",
  "version": "2.0.0-beta.4.1",
  "identifier": "app.sinon.focars",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "FOCA-rs", "width": 1360, "height": 840, "minWidth": 1024, "minHeight": 640, "center": true, "decorations": true }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "media-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": false,
    "android": { "versionCode": 2000007 },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
